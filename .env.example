# Copy to .env and adjust. `docker compose` reads this file automatically.

# --- PostgreSQL ---
POSTGRES_USER=strata
# Generate a unique password with:  openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=strata

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
# Generate a real key with:  openssl rand -base64 48
JWT_KEY=
# Keep true for deployments; set false only for local HTTP development if needed.
AUTH_COOKIE_SECURE=true
JWT_ISSUER=strata
JWT_AUDIENCE=strata-web
JWT_EXPIRES_MINUTES=120

# Comma separated list of origins allowed to call the API directly
# (the nginx proxy in the frontend container is same-origin, so CORS is only
#  needed when you hit http://localhost:8080 straight from a browser).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Frontend ---
VITE_API_BASE_URL=/api
